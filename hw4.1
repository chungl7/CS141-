(defun MY-LENGTH(L)
    (if(null L)
        0
        (+1(MY_LENGTH(cdr L))))
)


(defun MY-MEMQ(A L)
    (cond
        ((null L) nil)
        ((eq A (car L)) L)
        (t (MY-MEMQ A (cdr L)))
    )
)


(defun MY-APPEND(L1 L2)
    (if (null L1)
        L2
        (cons (car L1)
            (MY-APPEND(cdr L1) L2))
    )
)

