(defun MY-LENGTH(L)
    (cond ((null L) 0)
        (t(+ 1 (MY-Length(cdr L))))
    )
)


(defun MY-MEMQ(A L)
    (cond ((null L) nil)
        ((eq A (car L)) L)
        (t (MY-MEMQ A (cdr L)))
    )
)


(defun MY-APPEND(L1 L2)
    (cond ((null L1) L2)
        (t (cons (car L1) (MY-APPEND(cdr L1) L2)))
    )
)

(defun MY-REVERSE_Helper(L ACC)
    (cond ((null L) ACC)
        (t (MY-REVERSE_Helper(cdr L) (cons (car L) ACC)))
    )
)

(defun MY-REVERSE(L)
    (MY-REVERSE_Helper L nil)
)

(defun MY-MAPCAR(f L)
    (cond ((null L) nil)
            (t (cons (apply f(list (car L)))
                (MY-MAPCAR f (cdr L))))
    )       
)

(defun MY-COPY(L)
    (cond ((atom L) L)
            (t (cons(MY-COPY(car L))
                (MY-COPY(cdr L))))
    )
)

(defun MY-NTH(L N)
    (cond ((<= N 0) (cons nil L))
            ((null L) nil)
            ((= N 1) L)
            (t (MY-NTH (cdr L) (1- N)))
    )
)

(defun MY-REMOVE(X L)
    (cond ((null L) nil)
            ((equal X (car L)) (MY-REMOVE X (cdr L)))
            (t (cons (car L) (MY-REMOVE X (cdr L))))
    )
)

(defun MY-SUBST (X Y Z)
    (cond ((equal Z X) Y)
            ((atom Z) Z)
            (t (cons (MY-SUBST X Y (car Z))
                    (MY-SUBST X Y (cdr Z))
                )
            )
    )
)

(defun MY-SUBSET(FN L)
    (cond ((null L) nil)
            ((apply FN (list (car L)))
                (cons (car L) (MY-SUBSET FN (cdr L)))
            )
            (t (MY-SUBSET FN (cdr L)))
    )
)

(defun MY-ADD_HELPER (L1 L2 CARRY)
    (cond ((and (null L1) (null L2))
        (cond ((> CARRY 0) (cons CARRY nil)) (t nil)))
        (t (cons (mod (+ (cond ((null L1) 0) (t (car L1)))
                (cond ((null L2) 0) (t (car L2)))
                CARRY)
                    10)
        (MY-ADD_HELPER
        (cond ((null L1) nil) (t (cdr L1)))
        (cond ((null L2) nil) (t (cdr L2)))
        (floor (/ (+ (cond ((null L1) 0) (t (car L1)))
                        (cond ((null L2) 0) (t (car L2)))
                        CARRY)
                10)
        )
        )
            )
        )
    )
)

(defun MY-ADD(N1 N2)
    (MY-ADD_HELPER N1 N2 0)
)

(defun MY-MERGE(L1 L2)
    (cond ((null L1) L2)
            ((null L2) L1)
            ((<= (car L1) (car L2))
            (cons (car L1) (MY-MERGE(cdr L1) L2)))
            (t
            (cons (car L2) (MY-MERGE L1 (cdr L2))))
    )
)

(defun MY-SUBLIST_Helper(L1 L2)
    (cond ((null L1) t)
            ((null L2) nil)
            ((eq (car L1) (car L2)) (MY-SUBLIST_Helper(cdr L1) (cdr L2)))
            (t nil)
    )
)

(defun MY-SUBLIST(L1 L2)
    (cond ((null L1) t)
            ((null L2) nil)
            ((MY-SUBLIST_Helper L1 L2) t)
            (t (MY-SUBLIST L1 (cdr L2)))
    )
)

(defun MY-ASSOC(A ALIST)
    (cond ((null ALIST) nil)
        ((eq A (car (car ALIST))) (car ALIST))
        (t(MY-ASSOC A (cdr ALIST)))
    )
)

(defun MY-REPLACE(ALIST L)
    (cond ((atom L)
            (cond ((MY-ASSOC L ALIST) (cdr(MY-ASSOC L ALIST)))
                (t L))
            )
            (t (cons(MY-REPLACE ALIST (car L))
                (MY-REPLACE ALIST (cdr L))))
    )
)